# Copy to .env and adjust. Values below match docker-compose.yml as seen from the host.
# Host ports are 5433/6380 so the stack never collides with a locally installed
# PostgreSQL or Redis. Inside the compose network the services use 5432/6379.
DATABASE_URL=postgresql+asyncpg://bulk:bulk@localhost:5433/bulk_actions
REDIS_URL=redis://localhost:6380/0

# Entities pulled from Postgres and pushed onto the queue per batch job.
BATCH_SIZE=1000
MAX_BATCH_SIZE=10000

# Per-account processing ceiling (entities/minute). The assignment asks for 10k/min.
DEFAULT_RATE_LIMIT_PER_MINUTE=10000
# Requests/minute allowed against POST /bulk-actions per account.
API_RATE_LIMIT_PER_MINUTE=120

# arq worker
WORKER_CONCURRENCY=20
JOB_MAX_TRIES=3

LOG_LEVEL=INFO
LOG_JSON=true
